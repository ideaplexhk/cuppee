# NODE_ENV=production refuses the dev defaults below.
PORT=8787
DB_PATH=./cuppee.db
CARD_SECRET=change-me
# NTAG 424 SDM keys (32 hex). All-zero = factory keys, development only.
SDM_META_READ_KEY=00000000000000000000000000000000
SDM_FILE_READ_KEY=00000000000000000000000000000000
# Accept plain-UID (NTAG 213) cups. Set 0 once all cups are NTAG 424.
ALLOW_UID_ONLY=1
DEBOUNCE_SECONDS=30
VISIT_COOLDOWN_MINUTES=15
PENDING_TTL_MINUTES=15
POS_MATCH_WINDOW_MINUTES=10
POS_GENERIC_SECRET=change-me

# PostgreSQL (backlog M1). Used by the migration runner now and by the server after the port (M1.3).
DATABASE_URL=postgres://cuppee:cuppee@localhost:5432/cuppee
